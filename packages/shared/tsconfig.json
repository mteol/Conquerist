{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Kein "types": [] mit DOM-Libs - shared muss im Browser UND in Node laufen,
    // also darf hier weder DOM noch @types/node im Sichtfeld sein.
    "lib": ["ES2023"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  // "src" allein greift nur .ts/.tsx - fuer den JSON-Import der Fixture in
  // game.integration.test.ts (Aufgabe 13) braucht es das Muster extra.
  "include": ["src", "src/**/*.json"]
}
