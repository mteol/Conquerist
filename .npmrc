# pnpm fuehrt pre-/post-Skripte seit v7 standardmaessig NICHT aus.
# Ohne diese Zeile laeuft "predev" nicht und "pnpm dev" startet gegen ein
# fehlendes packages/shared/dist.
enable-pre-post-scripts=true

# Workspace-Pakete immer per Symlink verknuepfen, nie aus einer Registry ziehen.
link-workspace-packages=true
prefer-workspace-packages=true
