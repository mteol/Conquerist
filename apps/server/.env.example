# Alle Werte haben Entwicklungs-Defaults - diese Datei ist Dokumentation,
# keine Voraussetzung. Kopieren nach .env nur, wenn etwas abweichen soll.

NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# Erlaubte Browser-Origins fuer den WebSocket-Upgrade, kommasepariert.
# Das ist der VITE-Port (5173), nicht der Server-Port: der Browser verbindet
# auf location.host, Vite proxyt nach 8080 und reicht den Origin-Header durch.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
