# Alle Werte haben Entwicklungs-Defaults - diese Datei ist Dokumentation,
# keine Voraussetzung. Kopieren nach .env nur, wenn etwas abweichen soll.

NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# Zusaetzlich erlaubte Browser-Origins fuer den WebSocket-Upgrade,
# kommasepariert. Gleicher Ursprung ist seit Etappe 4 immer erlaubt - diese
# Liste ist nur fuer den Dev-Proxy noetig.
# Das ist der VITE-Port (5173), nicht der Server-Port: der Browser verbindet
# auf location.host, Vite proxyt nach 8080 und reicht den Origin-Header durch.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Wo die SQLite-Datei liegt. ":memory:" ist erlaubt und in Tests der Normalfall.
# Der Default liegt unter data/, und data/ steht in .gitignore.
DATABASE_FILE=./data/conquerist.db

# --- In Produktion (Coolify) abweichend: -----------------------------------
# NODE_ENV=production
# HOST=0.0.0.0                        <- der Default waere im Container unerreichbar
# PORT=8477                           <- im Container, weil 8080 auf dem Host vergeben ist
# DATABASE_FILE=/data/conquerist.db   <- das Volume, nicht das Containerdateisystem
#
# CLIENT_ORIGIN bleibt dort UNGESETZT: der Server liefert den Client selbst
# aus, gleicher Ursprung ist immer erlaubt, und isAllowedOrigin vergleicht nur
# Host und Port - die TLS-Terminierung des Proxys stoert es also nicht.
