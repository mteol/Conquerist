{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "rootDir": "src",
    // Der Bundle kommt von Vite; tsc laeuft hier nur zur Typpruefung. Die
    // Deklarationen landen in .tsbuild und werden nicht ausgeliefert - sie
    // existieren nur, damit "tsc -b" das Projekt als composite behandeln kann.
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": ".tsbuild/.tsbuildinfo"
  },
  "include": ["src"],
  "references": [{ "path": "../../packages/shared" }]
}
